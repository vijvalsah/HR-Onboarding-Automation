# Application
APP_NAME=onboarding-automation
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Server (optional overrides for uvicorn)
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Database
# Dev default is an async SQLite file. For Postgres use:
#   postgresql+asyncpg://user:pass@localhost:5432/onboarding
DATABASE_URL=sqlite+aiosqlite:///./onboarding.db

# JWT (auth). MUST match web AUTH_JWT_SECRET for cross-process token validation.
# In production, set a unique value >= 32 chars — the app refuses to boot otherwise.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-change-me-in-production-min-32-chars!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI chat provider: mock | openai | gemini
# "mock" needs no key. Set a key and switch the provider to use a real model.
CHAT_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
